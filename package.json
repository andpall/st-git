{
  "name": "st-git",
  "displayName": "st-git",
  "description": "Android Studio-like git log: graph, undo commit, squash, rebase",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stGit",
          "title": "st-git",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "stGit": [
        {
          "id": "st-git.localChanges",
          "name": "Local Changes"
        },
        {
          "type": "webview",
          "id": "st-git.commit",
          "name": "Commit"
        },
        {
          "type": "webview",
          "id": "st-git.graph",
          "name": "Log"
        },
        {
          "id": "st-git.changes",
          "name": "Changes"
        },
        {
          "id": "st-git.conflicts",
          "name": "Conflicts",
          "when": "st-git.rebasing || st-git.hasConflicts"
        }
      ]
    },
    "commands": [
      {
        "command": "st-git.refresh",
        "title": "Refresh",
        "category": "st-git",
        "icon": "$(refresh)"
      },
      {
        "command": "st-git.undoCommit",
        "title": "Undo Commit",
        "category": "st-git"
      },
      {
        "command": "st-git.squash",
        "title": "Squash Commits",
        "category": "st-git"
      },
      {
        "command": "st-git.rebaseOnto",
        "title": "Rebase Current Branch onto This",
        "category": "st-git"
      },
      {
        "command": "st-git.rebaseContinue",
        "title": "Continue Rebase",
        "category": "st-git",
        "icon": "$(debug-continue)"
      },
      {
        "command": "st-git.rebaseAbort",
        "title": "Abort Rebase",
        "category": "st-git",
        "icon": "$(discard)"
      },
      {
        "command": "st-git.openDiff",
        "title": "Open Diff",
        "category": "st-git"
      },
      {
        "command": "st-git.acceptCurrent",
        "title": "Accept Current (HEAD)",
        "category": "st-git",
        "icon": "$(arrow-left)"
      },
      {
        "command": "st-git.acceptIncoming",
        "title": "Accept Incoming (Commit)",
        "category": "st-git",
        "icon": "$(arrow-right)"
      },
      {
        "command": "st-git.openMerge",
        "title": "Merge...",
        "category": "st-git",
        "icon": "$(git-merge)"
      },
      {
        "command": "st-git.amendCommit",
        "title": "Amend Commit...",
        "category": "st-git",
        "icon": "$(edit)"
      },
      {
        "command": "st-git.openLocalDiff",
        "title": "Open Diff",
        "category": "st-git"
      },
      {
        "command": "st-git.branches",
        "title": "Branches...",
        "category": "st-git",
        "icon": "$(git-branch)"
      },
      {
        "command": "st-git.checkoutCommit",
        "title": "Checkout...",
        "category": "st-git"
      },
      {
        "command": "st-git.newBranch",
        "title": "New Branch...",
        "category": "st-git"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "st-git.rebaseContinue",
          "when": "view == st-git.graph && st-git.rebasing",
          "group": "navigation@1"
        },
        {
          "command": "st-git.rebaseAbort",
          "when": "view == st-git.graph && st-git.rebasing",
          "group": "navigation@2"
        },
        {
          "command": "st-git.amendCommit",
          "when": "view == st-git.graph && !st-git.rebasing",
          "group": "navigation@3"
        },
        {
          "command": "st-git.refresh",
          "when": "view == st-git.graph",
          "group": "navigation@4"
        },
        {
          "command": "st-git.rebaseContinue",
          "when": "view == st-git.conflicts && st-git.rebasing",
          "group": "navigation@1"
        },
        {
          "command": "st-git.rebaseAbort",
          "when": "view == st-git.conflicts && st-git.rebasing",
          "group": "navigation@2"
        },
        {
          "command": "st-git.refresh",
          "when": "view == st-git.localChanges",
          "group": "navigation"
        },
        {
          "command": "st-git.branches",
          "when": "view == st-git.graph",
          "group": "navigation@0"
        },
        {
          "command": "st-git.branches",
          "when": "view == st-git.localChanges",
          "group": "navigation@0"
        }
      ],
      "webview/context": [
        {
          "command": "st-git.checkoutCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "0_branch@0"
        },
        {
          "command": "st-git.newBranch",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "0_branch@1"
        },
        {
          "command": "st-git.amendCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_git@0"
        },
        {
          "command": "st-git.undoCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_git@1"
        },
        {
          "command": "st-git.squash",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_git@2"
        },
        {
          "command": "st-git.rebaseOnto",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_git@3"
        }
      ],
      "commandPalette": [
        {
          "command": "st-git.undoCommit",
          "when": "false"
        },
        {
          "command": "st-git.squash",
          "when": "false"
        },
        {
          "command": "st-git.rebaseOnto",
          "when": "false"
        },
        {
          "command": "st-git.openDiff",
          "when": "false"
        },
        {
          "command": "st-git.acceptCurrent",
          "when": "false"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "false"
        },
        {
          "command": "st-git.openMerge",
          "when": "false"
        },
        {
          "command": "st-git.openLocalDiff",
          "when": "false"
        },
        {
          "command": "st-git.checkoutCommit",
          "when": "false"
        },
        {
          "command": "st-git.newBranch",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "st-git.acceptCurrent",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@1"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@2"
        },
        {
          "command": "st-git.openMerge",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@3"
        },
        {
          "command": "st-git.acceptCurrent",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@1"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@2"
        },
        {
          "command": "st-git.openMerge",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "playground:reset": "bash scripts/playground.sh --reset"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "typescript": "^7.0.2"
  }
}
