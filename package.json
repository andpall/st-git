{
  "name": "st-git",
  "displayName": "st-git",
  "description": "Full git client in the sidebar: commit graph, local changes, branches, stashes, squash, rebase and conflict resolution",
  "version": "0.1.2",
  "publisher": "andpall",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/andpall/st-git"
  },
  "sponsor": {
    "url": "https://boosty.to/andpall"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "log",
    "graph",
    "rebase",
    "squash",
    "android studio",
    "intellij"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stGit",
          "title": "st-git",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "stGit": [
        {
          "id": "st-git.localChanges",
          "name": "Local Changes",
          "initialSize": 2
        },
        {
          "type": "webview",
          "id": "st-git.commit",
          "name": "Commit",
          "initialSize": 1.4
        },
        {
          "type": "webview",
          "id": "st-git.graph",
          "name": "Log",
          "initialSize": 6
        },
        {
          "id": "st-git.changes",
          "name": "Changes",
          "initialSize": 2
        },
        {
          "id": "st-git.conflicts",
          "name": "Conflicts",
          "when": "st-git.operation || st-git.hasConflicts",
          "initialSize": 2
        },
        {
          "id": "st-git.stashes",
          "name": "Stashes",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "st-git.refresh",
        "title": "Refresh",
        "category": "st-git",
        "icon": "$(refresh)"
      },
      {
        "command": "st-git.undoCommit",
        "title": "Undo Commit",
        "category": "st-git"
      },
      {
        "command": "st-git.squash",
        "title": "Squash Commits",
        "category": "st-git"
      },
      {
        "command": "st-git.rebaseOnto",
        "title": "Rebase Current Branch onto This",
        "category": "st-git"
      },
      {
        "command": "st-git.rebaseOntoBranch",
        "title": "Rebase Current Branch onto Branch...",
        "category": "st-git"
      },
      {
        "command": "st-git.mergeCommit",
        "title": "Merge into Current Branch",
        "category": "st-git"
      },
      {
        "command": "st-git.openDiff",
        "title": "Open Diff",
        "category": "st-git"
      },
      {
        "command": "st-git.acceptCurrent",
        "title": "Accept Current (HEAD)",
        "category": "st-git",
        "icon": "$(arrow-left)"
      },
      {
        "command": "st-git.acceptIncoming",
        "title": "Accept Incoming (Commit)",
        "category": "st-git",
        "icon": "$(arrow-right)"
      },
      {
        "command": "st-git.openMerge",
        "title": "Merge...",
        "category": "st-git",
        "icon": "$(git-merge)"
      },
      {
        "command": "st-git.amendCommit",
        "title": "Amend Commit...",
        "category": "st-git",
        "icon": "$(edit)"
      },
      {
        "command": "st-git.openLocalDiff",
        "title": "Open Diff",
        "category": "st-git"
      },
      {
        "command": "st-git.branches",
        "title": "Branches...",
        "category": "st-git",
        "icon": "$(git-branch)"
      },
      {
        "command": "st-git.checkoutCommit",
        "title": "Checkout...",
        "category": "st-git"
      },
      {
        "command": "st-git.newBranch",
        "title": "New Branch...",
        "category": "st-git"
      },
      {
        "command": "st-git.continueOperation",
        "title": "Continue",
        "category": "st-git",
        "icon": "$(debug-continue)"
      },
      {
        "command": "st-git.abortOperation",
        "title": "Abort",
        "category": "st-git",
        "icon": "$(discard)"
      },
      {
        "command": "st-git.push",
        "title": "Push...",
        "category": "st-git",
        "icon": "$(arrow-up)"
      },
      {
        "command": "st-git.pushUpToHere",
        "title": "Push All up to Here...",
        "category": "st-git"
      },
      {
        "command": "st-git.pull",
        "title": "Pull...",
        "category": "st-git",
        "icon": "$(arrow-down)"
      },
      {
        "command": "st-git.fetch",
        "title": "Fetch",
        "category": "st-git",
        "icon": "$(sync)"
      },
      {
        "command": "st-git.rollback",
        "title": "Rollback...",
        "category": "st-git",
        "icon": "$(discard)"
      },
      {
        "command": "st-git.addToGitignore",
        "title": "Add to .gitignore",
        "category": "st-git"
      },
      {
        "command": "st-git.stashChanges",
        "title": "Stash Changes...",
        "category": "st-git",
        "icon": "$(archive)"
      },
      {
        "command": "st-git.applyStash",
        "title": "Apply Stash",
        "category": "st-git",
        "icon": "$(check)"
      },
      {
        "command": "st-git.popStash",
        "title": "Pop Stash",
        "category": "st-git",
        "icon": "$(export)"
      },
      {
        "command": "st-git.dropStash",
        "title": "Drop Stash",
        "category": "st-git",
        "icon": "$(trash)"
      },
      {
        "command": "st-git.rewordCommit",
        "title": "Edit Commit Message...",
        "category": "st-git"
      },
      {
        "command": "st-git.dropCommit",
        "title": "Drop Commit",
        "category": "st-git"
      },
      {
        "command": "st-git.cherryPick",
        "title": "Cherry-Pick",
        "category": "st-git"
      },
      {
        "command": "st-git.revertCommit",
        "title": "Revert Commit",
        "category": "st-git"
      },
      {
        "command": "st-git.resetToHere",
        "title": "Reset Current Branch to Here...",
        "category": "st-git"
      },
      {
        "command": "st-git.compareWithCurrent",
        "title": "Compare with Current Branch",
        "category": "st-git"
      },
      {
        "command": "st-git.toggleBlame",
        "title": "Annotate with Git Blame",
        "category": "st-git"
      },
      {
        "command": "st-git.showFileHistory",
        "title": "Show Git History",
        "category": "st-git",
        "icon": "$(history)"
      },
      {
        "command": "st-git.revealCommit",
        "title": "Show Commit in Log",
        "category": "st-git"
      },
      {
        "command": "st-git.newTag",
        "title": "New Tag...",
        "category": "st-git"
      },
      {
        "command": "st-git.pushTag",
        "title": "Push Tag...",
        "category": "st-git"
      },
      {
        "command": "st-git.deleteTag",
        "title": "Delete Tag...",
        "category": "st-git"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "st-git.continueOperation",
          "when": "(view == st-git.graph || view == st-git.conflicts) && st-git.operation",
          "group": "navigation@0"
        },
        {
          "command": "st-git.abortOperation",
          "when": "(view == st-git.graph || view == st-git.conflicts) && st-git.operation",
          "group": "navigation@1"
        },
        {
          "command": "st-git.branches",
          "when": "view == st-git.graph",
          "group": "navigation@2"
        },
        {
          "command": "st-git.pull",
          "when": "view == st-git.graph",
          "group": "navigation@3"
        },
        {
          "command": "st-git.push",
          "when": "view == st-git.graph",
          "group": "navigation@4"
        },
        {
          "command": "st-git.fetch",
          "when": "view == st-git.graph",
          "group": "navigation@5"
        },
        {
          "command": "st-git.amendCommit",
          "when": "view == st-git.graph && !st-git.operation",
          "group": "1_more@1"
        },
        {
          "command": "st-git.refresh",
          "when": "view == st-git.graph",
          "group": "1_more@2"
        },
        {
          "command": "st-git.branches",
          "when": "view == st-git.localChanges",
          "group": "navigation@0"
        },
        {
          "command": "st-git.rollback",
          "when": "view == st-git.localChanges",
          "group": "navigation@1"
        },
        {
          "command": "st-git.stashChanges",
          "when": "view == st-git.localChanges",
          "group": "navigation@2"
        },
        {
          "command": "st-git.refresh",
          "when": "view == st-git.localChanges",
          "group": "navigation@3"
        },
        {
          "command": "st-git.stashChanges",
          "when": "view == st-git.stashes",
          "group": "navigation@0"
        }
      ],
      "webview/context": [
        {
          "command": "st-git.checkoutCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "0_branch@0"
        },
        {
          "command": "st-git.newBranch",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "0_branch@1"
        },
        {
          "command": "st-git.amendCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_edit@2"
        },
        {
          "command": "st-git.rewordCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_edit@3"
        },
        {
          "command": "st-git.undoCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_edit@4"
        },
        {
          "command": "st-git.squash",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_edit@5"
        },
        {
          "command": "st-git.dropCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "1_edit@6"
        },
        {
          "command": "st-git.pushUpToHere",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "2_apply@6"
        },
        {
          "command": "st-git.cherryPick",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "2_apply@7"
        },
        {
          "command": "st-git.revertCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "2_apply@8"
        },
        {
          "command": "st-git.rebaseOntoBranch",
          "when": "webviewId == st-git.graph && webviewSection == commit && hasBranch",
          "group": "3_branch@9"
        },
        {
          "command": "st-git.rebaseOnto",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "3_branch@9"
        },
        {
          "command": "st-git.mergeCommit",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "3_branch@9"
        },
        {
          "command": "st-git.resetToHere",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "3_branch@10"
        },
        {
          "command": "st-git.newTag",
          "when": "webviewId == st-git.graph && webviewSection == commit",
          "group": "4_tag@1"
        },
        {
          "command": "st-git.pushTag",
          "when": "webviewId == st-git.graph && webviewSection == commit && hasTag",
          "group": "4_tag@2"
        },
        {
          "command": "st-git.deleteTag",
          "when": "webviewId == st-git.graph && webviewSection == commit && hasTag",
          "group": "4_tag@3"
        }
      ],
      "commandPalette": [
        {
          "command": "st-git.checkoutCommit",
          "when": "false"
        },
        {
          "command": "st-git.newBranch",
          "when": "false"
        },
        {
          "command": "st-git.undoCommit",
          "when": "false"
        },
        {
          "command": "st-git.squash",
          "when": "false"
        },
        {
          "command": "st-git.rebaseOnto",
          "when": "false"
        },
        {
          "command": "st-git.openDiff",
          "when": "false"
        },
        {
          "command": "st-git.openLocalDiff",
          "when": "false"
        },
        {
          "command": "st-git.acceptCurrent",
          "when": "false"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "false"
        },
        {
          "command": "st-git.openMerge",
          "when": "false"
        },
        {
          "command": "st-git.rewordCommit",
          "when": "false"
        },
        {
          "command": "st-git.dropCommit",
          "when": "false"
        },
        {
          "command": "st-git.cherryPick",
          "when": "false"
        },
        {
          "command": "st-git.revertCommit",
          "when": "false"
        },
        {
          "command": "st-git.resetToHere",
          "when": "false"
        },
        {
          "command": "st-git.compareWithCurrent",
          "when": "false"
        },
        {
          "command": "st-git.applyStash",
          "when": "false"
        },
        {
          "command": "st-git.popStash",
          "when": "false"
        },
        {
          "command": "st-git.dropStash",
          "when": "false"
        },
        {
          "command": "st-git.rollback",
          "when": "false"
        },
        {
          "command": "st-git.revealCommit",
          "when": "false"
        },
        {
          "command": "st-git.addToGitignore",
          "when": "false"
        },
        {
          "command": "st-git.mergeCommit",
          "when": "false"
        },
        {
          "command": "st-git.rebaseOntoBranch",
          "when": "false"
        },
        {
          "command": "st-git.newTag",
          "when": "false"
        },
        {
          "command": "st-git.pushTag",
          "when": "false"
        },
        {
          "command": "st-git.deleteTag",
          "when": "false"
        },
        {
          "command": "st-git.pushUpToHere",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "st-git.acceptCurrent",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@1"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@2"
        },
        {
          "command": "st-git.openMerge",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "inline@3"
        },
        {
          "command": "st-git.acceptCurrent",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@1"
        },
        {
          "command": "st-git.acceptIncoming",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@2"
        },
        {
          "command": "st-git.openMerge",
          "when": "view == st-git.conflicts && viewItem == conflict",
          "group": "1_resolve@3"
        },
        {
          "command": "st-git.rollback",
          "when": "view == st-git.localChanges && viewItem =~ /^localChange/",
          "group": "inline"
        },
        {
          "command": "st-git.rollback",
          "when": "view == st-git.localChanges && viewItem =~ /^localChange/",
          "group": "1_change"
        },
        {
          "command": "st-git.addToGitignore",
          "when": "view == st-git.localChanges && viewItem =~ /\\bunversioned\\b/",
          "group": "1_change@9"
        },
        {
          "command": "st-git.applyStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "inline@0"
        },
        {
          "command": "st-git.applyStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "1_stash@0"
        },
        {
          "command": "st-git.popStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "st-git.popStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "st-git.dropStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "st-git.dropStash",
          "when": "view == st-git.stashes && viewItem == stash",
          "group": "1_stash@2"
        }
      ],
      "editor/context": [
        {
          "command": "st-git.toggleBlame",
          "when": "resourceScheme == file",
          "group": "st-git@1"
        },
        {
          "command": "st-git.showFileHistory",
          "when": "resourceScheme == file",
          "group": "st-git@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "st-git.toggleBlame",
          "when": "resourceScheme == file",
          "group": "st-git@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "st-git.showFileHistory",
          "when": "resourceScheme == file",
          "group": "st-git@1"
        }
      ],
      "explorer/context": [
        {
          "command": "st-git.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "st-git@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "playground:reset": "bash scripts/playground.sh --reset",
    "package": "npx @vscode/vsce package",
    "release": "bash scripts/publish.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "typescript": "^7.0.2"
  }
}
